# ===== 운영 환경 (.env) =====
# docker-compose.yml에서 사용

# PostgreSQL Configuration
POSTGRES_DB=couple_diary
POSTGRES_USER=<db_user>
POSTGRES_PASSWORD=<db_password>

# PostgreSQL Test Configuration
POSTGRES_TEST_DB=couple_diary_test
POSTGRES_TEST_USER=<db_user>
POSTGRES_TEST_PASSWORD=<db_test_password>

# Storage Configuration (S3 or MinIO)
STORAGE_ENDPOINT=<storage_endpoint_or_empty_for_aws_s3>
STORAGE_ACCESS_KEY=<storage_access_key>
STORAGE_SECRET_KEY=<storage_secret_key>
STORAGE_BUCKET=couple-diary-media

# Domain Configuration
DOMAIN=your-domain.com
